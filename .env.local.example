# Copie este arquivo para .env.local e preencha o que for usar. Nada aqui é obrigatório para
# rodar o app localmente (perfis, templates, lotes e renderização real via ffmpeg já
# funcionam sem nenhuma credencial) — só é necessário para conectar Google Drive/YouTube e
# publicar direto nas redes sociais.
#
# IMPORTANTE: Instagram, Facebook e TikTok pedem o vídeo por uma URL pública HTTPS (os
# servidores deles baixam o arquivo, não aceitam "localhost"). Para testar essas três
# plataformas você precisa expor o servidor publicamente — ex.: um túnel (ngrok, Cloudflare
# Tunnel) apontando pra porta 3000, ou um deploy de verdade — e usar essa URL pública em
# PUBLIC_BASE_URL. O YouTube é exceção: o upload é direto pela API autenticada, funciona a
# partir do localhost.

# --- Google Drive (storage de vídeos agendados) ---
# 1. Acesse https://console.cloud.google.com/ e crie um projeto (ou use um existente).
# 2. Em "APIs e serviços" > "Biblioteca", habilite "Google Drive API".
# 3. Em "APIs e serviços" > "Tela de consentimento OAuth", configure como "Externo" e
#    adicione seu próprio e-mail como usuário de teste (não precisa de aprovação do Google
#    para uso pessoal com poucos usuários de teste).
# 4. Em "Credenciais", crie um "ID do cliente OAuth" do tipo "Aplicativo da Web", com
#    GOOGLE_REDIRECT_URI abaixo cadastrada em "URIs de redirecionamento autorizados".
# Importante: NÃO habilite/peça o escopo do YouTube junto — a Google bloqueia combinar
# youtube.upload com outros escopos no mesmo consentimento ("scopes that cannot be requested
# together"). Por isso o upload direto no YouTube (lib/server/publishing/youtube.ts) fica
# desabilitado na prática até ganhar um fluxo de conexão só dele.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
# Assina as URLs temporárias que a Meta usa para baixar vídeos guardados no Drive (ver
# app/api/drive/stream/[fileId]/route.ts) — só necessária se for usar o Drive como storage de
# vídeos agendados. Gere com: openssl rand -hex 24. Se vazia, cai no META_TOKEN_ENCRYPTION_KEY.
DRIVE_STREAM_SECRET=

# --- Instagram + Facebook (Meta OAuth multi-conta) ---
# Fluxo novo usado pelas telas /contas-meta e /publicar. Veja docs/META_INTEGRATION_SETUP.md.
# 1. Crie um app Business em https://developers.facebook.com/apps/.
# 2. Cadastre META_REDIRECT_URI em "URIs de redirecionamento OAuth válidos".
# 3. Gere META_TOKEN_ENCRYPTION_KEY com: openssl rand -base64 32
# 4. Para testar localmente, exponha a porta 7070 com HTTPS público (ngrok/Cloudflare Tunnel)
#    e use essa URL no META_REDIRECT_URI e PUBLIC_BASE_URL.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://SEU-DOMINIO/api/meta/callback
# Para desenvolvimento local, depois do callback público a interface volta para localhost.
META_DASHBOARD_BASE_URL=http://127.0.0.1:7070
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0
# ID da configuracao criada em Facebook Login for Business — só usado pelo fluxo "Conectar
# Facebook" (via Página), opcional se você só for usar o Instagram Login abaixo.
META_LOGIN_CONFIG_ID=
# --- Instagram Login (fluxo PRINCIPAL: "Conectar Instagram", sem Página do Facebook) ---
# Ative o produto "Instagram" no seu app em developers.facebook.com/apps/SEU_APP_ID/instagram/.
# Cadastre META_INSTAGRAM_REDIRECT_URI em "Instagram Business Login" → URIs de redirecionamento.
# Se vazio, usa META_APP_ID/SECRET (um único app cobrindo os dois fluxos funciona normalmente).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://SEU-DOMINIO/api/meta/instagram/callback
META_INSTAGRAM_GRAPH_API_VERSION=v26.0
# basic = valida login sem pedir permissões avançadas; publish = pede Páginas/Instagram/autopost/métricas
# depois que a Meta liberar pages_show_list/instagram_content_publish/instagram_manage_insights para o app.
META_OAUTH_SCOPE_MODE=basic
# Opcional: substitui a lista acima por escopos explícitos separados por vírgula.
META_OAUTH_SCOPES=
# Protege POST/GET /api/scheduled-posts/run-due contra chamadas externas não autorizadas.
# Gere com: openssl rand -hex 24. Se definida na Vercel, a Vercel Cron Job já envia sozinha o
# header "Authorization: Bearer <valor>" — não precisa configurar nada além da env var.
CRON_SECRET=

# --- Instagram + Facebook legado (conta única) ---
# Mantido só para compatibilidade com os adapters antigos em lib/server/publishing/*.
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# --- TikTok (Content Posting API) ---
# 1. Crie um app em https://developers.tiktok.com/apps/ e peça acesso ao escopo
#    "video.publish" (exige revisão do TikTok antes de publicar fora do modo sandbox).
# 2. TIKTOK_ACCESS_TOKEN é o access token do criador, obtido via OAuth 2.0 + PKCE do TikTok
#    Login Kit — esse fluxo de login ainda não está implementado neste projeto; gere o
#    token manualmente durante os testes (ex.: TikTok OAuth Playground) até isso ser
#    automatizado.
TIKTOK_ACCESS_TOKEN=

# --- Kwai ---
# Não existe API pública de publicação para terceiros/criadores no Brasil — publicação
# nessa plataforma continua manual, direto pelo app.

# --- Geral ---
# URL pública (com https://) onde este app está acessível — necessária para Instagram/
# Facebook/TikTok baixarem o vídeo renderizado. Deixe em branco enquanto só usa localhost
# (Drive/YouTube continuam funcionando normalmente).
PUBLIC_BASE_URL=

# --- Supabase Storage para espaço interno dos lotes ---
# 1. Crie um projeto em https://supabase.com/ e um bucket Storage (ex.: zenx-lotes).
# 2. Preencha a service role key apenas no servidor/local .env.local; nunca exponha essa chave
#    no frontend. Se o bucket for público, os links gerados ficam prontos para download/postagem.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zenx-lotes
